typeattribute vendor_mdm_helper mlstrustedsubject;

init_daemon_domain(vendor_mdm_helper)

# Allow MDM helper to read SSR property
get_prop(vendor_mdm_helper, vendor_ssr_prop)

# Allow MDM helper to access SSR, ESOC and MHI devices
allow vendor_mdm_helper vendor_ssr_device:chr_file r_file_perms;
allow vendor_mdm_helper vendor_esoc_device:dir r_dir_perms;
allow vendor_mdm_helper vendor_esoc_device:chr_file rw_file_perms;
allow vendor_mdm_helper vendor_mhi_device:chr_file rw_file_perms;

# Allow MDM helper to execute vendor shell, itself and /vendor/bin/ks
allow vendor_mdm_helper vendor_shell_exec:file { rx_file_perms execute_no_trans };
allow vendor_mdm_helper vendor_mdm_helper_exec:file { rx_file_perms execute_no_trans };
allow vendor_mdm_helper ks_exec:file { rx_file_perms execute_no_trans };

# Allow MDM helper to use wakelocks
wakelock_use(vendor_mdm_helper)

# Allow MDM helper to signal processes
allow vendor_mdm_helper self:capability kill;

# Needed by ks in order to access the efs sync partitions
allow vendor_mdm_helper block_device:dir r_dir_perms;
allow vendor_mdm_helper { efs_boot_device vendor_efs_boot_dev }:blk_file rw_file_perms;

# Allow MDM helper to read modem firmware files
r_dir_file(vendor_mdm_helper, firmware_file)

# Allow MDM helper to have needed access for vendor data files
allow vendor_mdm_helper system_data_file:dir getattr;
allow vendor_mdm_helper vendor_data_file:dir { r_dir_perms write };

# Allow MDM helper to manage recovery files under /mnt/vendor
allow vendor_mdm_helper mnt_vendor_file:dir rw_dir_perms;
allow vendor_mdm_helper mnt_vendor_file:file create_file_perms;

# Allow MDM helper (kickstart) to use vendor and SDX55M tombstones
allow vendor_mdm_helper { vendor_tombstone_data_file mdm_tombstone_data_file }:dir create_dir_perms;
allow vendor_mdm_helper { vendor_tombstone_data_file mdm_tombstone_data_file }:file create_file_perms;
allow vendor_mdm_helper vendor_tombstone_data_file:fifo_file { create open read write };
